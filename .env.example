# --- Claude / LLM ---
ANTHROPIC_API_KEY=
# Model ID. Default is Haiku 4.5 (cheapest, best fit for short SMS). Change to
# claude-sonnet-4-6 if multilingual/typo extraction accuracy needs it.
LLM_MODEL=claude-haiku-4-5

# --- Quo (formerly OpenPhone) ---
# NOTE: Quo auth does NOT use a Bearer prefix. The API key is sent as the
# raw value of the Authorization header. See providers/quo.ts.
QUO_API_KEY=
# Base64-encoded HMAC signing secret from the Quo webhook settings.
QUO_WEBHOOK_SECRET=
# The shop's own Quo phone number in E.164, e.g. +15104512800
QUO_PHONE_NUMBER=

# --- Inventory API (WordPress/WooCommerce plugin — separate deliverable) ---
INVENTORY_API_URL=https://oaklandbodyparts.com/wp-json/obp/v1
INVENTORY_API_KEY=

# --- Supabase Postgres ---
# Connection string (URI) from Supabase → Settings → Database → Connection string.
# NOTE: the host is db.<project-ref>.supabase.co — do NOT include "https://" in it.
# Put the REAL value in .env.local (gitignored), not here.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Shop config ---
SHOP_TIMEZONE=America/Los_Angeles
SHOP_ADDRESS=1911 Union St, Oakland
CONVERSATION_TTL_HOURS=2
# Hold expiry hour in shop-local time (24h). 18 = 6 PM.
HOLD_EXPIRY_HOUR=18

# --- Server ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development