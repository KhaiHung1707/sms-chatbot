# Optional config for the LOCAL DEV harness (npm run dev:local).
# Copy to .env.local and fill in only what you need for the level you want.
# .env.local is gitignored — never commit real keys.
#
# Which pieces become REAL depends on what you set:
#   (nothing)                       → Level 1: rule LLM + in-memory DB (default)
#   ANTHROPIC_API_KEY               → Level 2: real Claude Haiku for extraction
#   ANTHROPIC_API_KEY + DATABASE_URL → Level 3: also real Postgres (Supabase)

# --- Level 2: real LLM (test multilingual / typo extraction) ---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5          # or claude-sonnet-4-6 to compare accuracy

# --- Level 3: real Postgres (Supabase free tier — no VPS needed) ---
# Supabase → Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
